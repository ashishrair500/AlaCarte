package com.alaCarte.llmServices;

import com.alaCarte.llmServices.dto.LlmMetadata;
import com.alaCarte.llmServices.dto.LlmRequest;
import com.alaCarte.llmServices.dto.LlmResponse;
import dev.langchain4j.data.message.AiMessage;
import dev.langchain4j.data.message.ChatMessage;
import dev.langchain4j.data.message.SystemMessage;
import dev.langchain4j.data.message.UserMessage;
import dev.langchain4j.model.chat.ChatLanguageModel;
import dev.langchain4j.model.chat.StreamingChatLanguageModel;
import dev.langchain4j.model.googleai.GoogleAiGeminiChatModel;
import dev.langchain4j.model.openai.OpenAiChatModel;
import dev.langchain4j.model.openai.OpenAiStreamingChatModel;
import dev.langchain4j.model.output.Response;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;
import reactor.core.publisher.Flux;

import java.time.Duration;
import java.util.ArrayList;
import java.util.List;

/**
 * AI Models Service
 * Provides unified interface for interacting with different LLM providers (Gemini, OpenAI)
 * Supports both streaming and non-streaming responses
 * Configuration-based model switching via application.properties
 */
@Service
public class AiModels {

    @Value("${langchain4j.google.ai.gemini.api-key}")
    private String geminiApiKey;

    @Value("${langchain4j.open-ai.api-key}")
    private String openaiApiKey;

    @Value("${llm.provider:gemini}")
    private String defaultProvider;

    @Value("${llm.model.name:gemini-1.5-flash}")
    private String defaultModelName;

    @Value("${llm.temperature:0.7}")
    private Double defaultTemperature;

    @Value("${llm.max-tokens:2000}")
    private Integer defaultMaxTokens;

    /**
     * Generate a response using the default configured model (non-streaming)
     *
     * @param request The LLM request containing user message and optional parameters
     * @return LlmResponse with content and metadata
     */
    public LlmResponse generate(LlmRequest request) {
        long startTime = System.currentTimeMillis();

        try {
            // Determine which provider to use
            String provider = defaultProvider.toLowerCase();
            String modelName = request.getModelOverride() != null ? request.getModelOverride() : defaultModelName;

            // Build the chat model based on provider
            ChatLanguageModel chatModel = buildChatModel(provider, modelName, request);

            // Prepare messages
            List<ChatMessage> messages = buildMessages(request);

            // Generate response
            Response<AiMessage> response = chatModel.generate(messages);

            // Extract content
            String content = response.content().text();

            // Build metadata
            LlmMetadata metadata = buildMetadata(response, provider, modelName, startTime);

            return LlmResponse.success(content, metadata);

        } catch (Exception e) {
            System.err.println("Error generating LLM response: " + e.getMessage());
            e.printStackTrace();
            return LlmResponse.error("Failed to generate response: " + e.getMessage());
        }
    }

    /**
     * Generate a streaming response using the default configured model
     * Note: Streaming is only supported for OpenAI models in version 0.35.0
     *
     * @param request The LLM request containing user message and optional parameters
     * @return Flux stream of string chunks
     */
    public Flux<String> generateStream(LlmRequest request) {
        try {
            // Determine which provider to use
            String provider = defaultProvider.toLowerCase();
            
            // Check if provider is Gemini (not supported for streaming in 0.35.0)
            if ("gemini".equals(provider)) {
                return Flux.error(new UnsupportedOperationException(
                    "Streaming is not supported for Gemini in LangChain4j 0.35.0. " +
                    "Please use generateWithOpenAiStream() or change llm.provider to 'openai' for streaming support."
                ));
            }
            
            String modelName = request.getModelOverride() != null ? request.getModelOverride() : defaultModelName;

            // Build the streaming chat model (OpenAI only)
            StreamingChatLanguageModel streamingModel = buildOpenAiStreamingChatModel(modelName, request);

            // Prepare messages
            List<ChatMessage> messages = buildMessages(request);

            // Create a Flux to handle streaming
            return Flux.create(sink -> {
                streamingModel.generate(messages, new dev.langchain4j.model.output.StreamingResponseHandler<AiMessage>() {
                    @Override
                    public void onNext(String token) {
                        sink.next(token);
                    }

                    @Override
                    public void onComplete(Response<AiMessage> response) {
                        sink.complete();
                    }

                    @Override
                    public void onError(Throwable error) {
                        sink.error(error);
                    }
                });
            });

        } catch (Exception e) {
            System.err.println("Error generating streaming LLM response: " + e.getMessage());
            e.printStackTrace();
            return Flux.error(new RuntimeException("Failed to generate streaming response: " + e.getMessage()));
        }
    }

    /**
     * Generate a response using Gemini model (non-streaming)
     *
     * @param request The LLM request
     * @return LlmResponse with content and metadata
     */
    public LlmResponse generateWithGemini(LlmRequest request) {
        long startTime = System.currentTimeMillis();

        try {
            String modelName = request.getModelOverride() != null ? request.getModelOverride() : "gemini-1.5-flash";

            ChatLanguageModel geminiModel = buildGeminiChatModel(modelName, request);
            List<ChatMessage> messages = buildMessages(request);
            Response<AiMessage> response = geminiModel.generate(messages);

            String content = response.content().text();
            LlmMetadata metadata = buildMetadata(response, "gemini", modelName, startTime);

            return LlmResponse.success(content, metadata);

        } catch (Exception e) {
            System.err.println("Error generating Gemini response: " + e.getMessage());
            e.printStackTrace();
            return LlmResponse.error("Failed to generate Gemini response: " + e.getMessage());
        }
    }

    /**
     * Generate a streaming response using Gemini model
     * Note: Gemini streaming is NOT supported in LangChain4j 0.35.0
     *
     * @param request The LLM request
     * @return Flux stream with error explaining streaming is not supported
     */
    public Flux<String> generateWithGeminiStream(LlmRequest request) {
        return Flux.error(new UnsupportedOperationException(
            "Gemini streaming is not supported in LangChain4j version 0.35.0. " +
            "Use generateWithGemini() for non-streaming responses, or use OpenAI for streaming support."
        ));
    }

    /**
     * Generate a response using OpenAI model (non-streaming)
     *
     * @param request The LLM request
     * @return LlmResponse with content and metadata
     */
    public LlmResponse generateWithOpenAi(LlmRequest request) {
        long startTime = System.currentTimeMillis();

        try {
            String modelName = request.getModelOverride() != null ? request.getModelOverride() : "gpt-4";

            ChatLanguageModel openAiModel = buildOpenAiChatModel(modelName, request);
            List<ChatMessage> messages = buildMessages(request);
            Response<AiMessage> response = openAiModel.generate(messages);

            String content = response.content().text();
            LlmMetadata metadata = buildMetadata(response, "openai", modelName, startTime);

            return LlmResponse.success(content, metadata);

        } catch (Exception e) {
            System.err.println("Error generating OpenAI response: " + e.getMessage());
            e.printStackTrace();
            return LlmResponse.error("Failed to generate OpenAI response: " + e.getMessage());
        }
    }

    /**
     * Generate a streaming response using OpenAI model
     *
     * @param request The LLM request
     * @return Flux stream of string chunks
     */
    public Flux<String> generateWithOpenAiStream(LlmRequest request) {
        try {
            String modelName = request.getModelOverride() != null ? request.getModelOverride() : "gpt-4";

            StreamingChatLanguageModel openAiStreamingModel = buildOpenAiStreamingChatModel(modelName, request);
            List<ChatMessage> messages = buildMessages(request);

            return Flux.create(sink -> {
                openAiStreamingModel.generate(messages, new dev.langchain4j.model.output.StreamingResponseHandler<AiMessage>() {
                    @Override
                    public void onNext(String token) {
                        sink.next(token);
                    }

                    @Override
                    public void onComplete(Response<AiMessage> response) {
                        sink.complete();
                    }

                    @Override
                    public void onError(Throwable error) {
                        sink.error(error);
                    }
                });
            });

        } catch (Exception e) {
            System.err.println("Error generating OpenAI streaming response: " + e.getMessage());
            e.printStackTrace();
            return Flux.error(new RuntimeException("Failed to generate OpenAI streaming response: " + e.getMessage()));
        }
    }

    // ============ Private Helper Methods ============

    /**
     * Build a chat model based on provider
     */
    private ChatLanguageModel buildChatModel(String provider, String modelName, LlmRequest request) {
        return switch (provider) {
            case "gemini" -> buildGeminiChatModel(modelName, request);
            case "openai" -> buildOpenAiChatModel(modelName, request);
            default -> throw new IllegalArgumentException("Unsupported provider: " + provider);
        };
    }

    /**
     * Build a streaming chat model based on provider
     * Note: Only OpenAI is supported for streaming in version 0.35.0
     */
    private StreamingChatLanguageModel buildStreamingChatModel(String provider, String modelName, LlmRequest request) {
        return switch (provider) {
            case "openai" -> buildOpenAiStreamingChatModel(modelName, request);
            case "gemini" -> throw new UnsupportedOperationException("Gemini streaming is not supported in LangChain4j 0.35.0");
            default -> throw new IllegalArgumentException("Unsupported provider: " + provider);
        };
    }

    /**
     * Build Gemini chat model
     */
    private ChatLanguageModel buildGeminiChatModel(String modelName, LlmRequest request) {
        Double temperature = request.getTemperature() != null ? request.getTemperature() : defaultTemperature;
        Integer maxTokens = request.getMaxTokens() != null ? request.getMaxTokens() : defaultMaxTokens;

        return GoogleAiGeminiChatModel.builder()
                .apiKey(geminiApiKey)
                .modelName(modelName)
                .temperature(temperature)
                .maxOutputTokens(maxTokens)
                .timeout(Duration.ofSeconds(60))
                .build();
    }

    /**
     * Build Gemini streaming chat model
     * Note: Not available in LangChain4j 0.35.0
     */
    private StreamingChatLanguageModel buildGeminiStreamingChatModel(String modelName, LlmRequest request) {
        throw new UnsupportedOperationException(
            "Gemini streaming is not supported in LangChain4j version 0.35.0. " +
            "Use a newer version of LangChain4j or use OpenAI for streaming support."
        );
    }

    /**
     * Build OpenAI chat model
     */
    private ChatLanguageModel buildOpenAiChatModel(String modelName, LlmRequest request) {
        Double temperature = request.getTemperature() != null ? request.getTemperature() : defaultTemperature;
        Integer maxTokens = request.getMaxTokens() != null ? request.getMaxTokens() : defaultMaxTokens;

        return OpenAiChatModel.builder()
                .apiKey(openaiApiKey)
                .modelName(modelName)
                .temperature(temperature)
                .maxTokens(maxTokens)
                .timeout(Duration.ofSeconds(60))
                .build();
    }

    /**
     * Build OpenAI streaming chat model
     */
    private StreamingChatLanguageModel buildOpenAiStreamingChatModel(String modelName, LlmRequest request) {
        Double temperature = request.getTemperature() != null ? request.getTemperature() : defaultTemperature;
        Integer maxTokens = request.getMaxTokens() != null ? request.getMaxTokens() : defaultMaxTokens;

        return OpenAiStreamingChatModel.builder()
                .apiKey(openaiApiKey)
                .modelName(modelName)
                .temperature(temperature)
                .maxTokens(maxTokens)
                .timeout(Duration.ofSeconds(60))
                .build();
    }

    /**
     * Build messages list from request
     */
    private List<ChatMessage> buildMessages(LlmRequest request) {
        List<ChatMessage> messages = new ArrayList<>();

        // Add system message if present
        if (request.getSystemMessage() != null && !request.getSystemMessage().isEmpty()) {
            messages.add(SystemMessage.from(request.getSystemMessage()));
        }

        // Add user message (required)
        if (request.getUserMessage() != null && !request.getUserMessage().isEmpty()) {
            messages.add(UserMessage.from(request.getUserMessage()));
        } else {
            throw new IllegalArgumentException("User message is required");
        }

        return messages;
    }

    /**
     * Build metadata from response
     */
    private LlmMetadata buildMetadata(Response<AiMessage> response, String provider, String modelName, long startTime) {
        long responseTime = System.currentTimeMillis() - startTime;

        LlmMetadata.Builder metadataBuilder = LlmMetadata.builder()
                .provider(provider)
                .modelUsed(modelName)
                .responseTimeMs(responseTime);

        // Extract token usage if available
        if (response.tokenUsage() != null) {
            metadataBuilder
                    .inputTokens(response.tokenUsage().inputTokenCount())
                    .outputTokens(response.tokenUsage().outputTokenCount())
                    .totalTokens(response.tokenUsage().totalTokenCount());
        }

        // Extract finish reason if available
        if (response.finishReason() != null) {
            metadataBuilder.finishReason(response.finishReason().toString());
        }

        return metadataBuilder.build();
    }

    // ============ Utility Methods ============

    /**
     * Get the currently configured default provider
     */
    public String getDefaultProvider() {
        return defaultProvider;
    }

    /**
     * Get the currently configured default model name
     */
    public String getDefaultModelName() {
        return defaultModelName;
    }

    /**
     * Get the currently configured default temperature
     */
    public Double getDefaultTemperature() {
        return defaultTemperature;
    }

    /**
     * Get the currently configured default max tokens
     */
    public Integer getDefaultMaxTokens() {
        return defaultMaxTokens;
    }
}
